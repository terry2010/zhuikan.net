[Unit]
Description=zhuikan.net update-check endpoint (news-update.zhuikan.net)
After=network.target

[Service]
Type=simple
User=zhuikan
WorkingDirectory=/data1/service/zhuikan-update
ExecStart=/usr/bin/node update-server.mjs
Restart=always
RestartSec=3
# 走容器部署时不用本文件；host 直跑时绑 webnet 网桥 IP（只暴露给 docker 网络，不对公网）
Environment=UPDATE_HOST=172.18.0.1
Environment=UPDATE_PORT=8788
# 收紧：只读最新公告+写 reports.jsonl
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data1/service/zhuikan-update
PrivateTmp=true

[Install]
WantedBy=multi-user.target
